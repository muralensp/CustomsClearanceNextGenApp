<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Day 27 - Monitoring & Metrics. OpenTelemetry .NET + Prometheus exporter,
    Microsoft's current recommended metrics instrumentation path, over the
    community prometheus-net package (confirmed with the user).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- FrameworkReference, same pattern as Platform.Logging/Security -
       MapPrometheusScrapingEndpoint needs ASP.NET Core's routing types. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
  </ItemGroup>

</Project>
