{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "LOCAL-DEV-ONLY-PLACEHOLDER-KEY-NEVER-USE-IN-PRODUCTION-32B",
    "Issuer": "https://dev.customsclearance.india",
    "Audience": "customsclearance-api-dev"
  },
  "ReverseProxy": {
    "Routes": {
      "diagnostics-secure-route": {
        "ClusterId": "api-cluster",
        "AuthorizationPolicy": "RequireAdmin",
        "Match": {
          "Path": "/diagnostics/secure"
        }
      },
      "api-route": {
        "ClusterId": "api-cluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "Destinations": {
          "api-destination": {
            "Address": "http://localhost:8080/"
          }
        }
      }
    }
  }
}
