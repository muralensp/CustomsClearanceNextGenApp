<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Coverage gate (Day 12). Platform.Common is a shared library, not
         business/rules logic or CRUD master data - treated as CRUD-tier
         (80%) per the classification convention in
         adr/0007-static-analysis-and-coverage-gates.md until it grows
         business logic of its own. -->
    <CollectCoverage>true</CollectCoverage>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>./TestResults/coverage/</CoverletOutput>
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <!-- Scope coverage to this project's own assembly only (Day 17
         finding - see Platform.Audit.Tests.csproj for the full
         explanation). No transitive dependency here yet, applied for
         consistency. -->
    <Include>[CustomsClearance.Platform.Common]*</Include>
  </PropertyGroup>

  <ItemGroup>
    <!-- coverlet.msbuild only (not coverlet.collector) - running both in the
         same project causes conflicting/empty coverage output, verified
         locally during Day 12. msbuild is required for threshold
         enforcement (dotnet test fails the build below threshold). -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Platform\Common\CustomsClearance.Platform.Common.csproj" />
  </ItemGroup>

</Project>
